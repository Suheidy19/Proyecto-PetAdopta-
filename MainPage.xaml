
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PetAdopta.MainPage"
    Title="PetAdopta"
    BackgroundColor="#F5F7F4">

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,25"
            Spacing="8">

            <Label
                Text="🐾 PetAdopta"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#315C48"/>

            <Label
                Text="Encuentra a tu nuevo mejor amigo"
                FontSize="15"
                TextColor="#66736A"/>

            <Label
                Text="Mascotas disponibles"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="#315C48"
                Margin="0,15,0,0"/>

        </VerticalStackLayout>

        <!-- Catálogo -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Mascotas}"
            Margin="15,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E1E8E1"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Nombre}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#315C48"/>

                            <Label
                                Text="{Binding Edad, StringFormat='Edad: {0} años'}"
                                FontSize="15"
                                TextColor="#555555"/>

                            <Label
                                Text="{Binding Raza, StringFormat='Raza: {0}'}"
                                FontSize="14"
                                TextColor="#66736A"/>

                            <Label
                                Text="{Binding Color, StringFormat='Color: {0}'}"
                                FontSize="14"
                                TextColor="#66736A"/>

                            <Button
                                Text="Conocer mascota"
                                BackgroundColor="#63A88C"
                                TextColor="White"
                                CornerRadius="10"/>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
